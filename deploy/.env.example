# Public hostname served by Caddy (used for Let's Encrypt).
PUBLIC_HOSTNAME=promptstreak.example.com

# Postgres credentials. Use a long random password.
POSTGRES_USER=promptstreak
POSTGRES_PASSWORD=replace-me-with-a-long-random-password
POSTGRES_DB=promptstreak

# Shared secret between Caddy's loopback admin vhost and the Next.js
# middleware. Generate with: openssl rand -hex 32
ADMIN_INTERNAL_PROXY_SECRET=replace-me-32-bytes-hex

# Salt used to hash IP / user-agent / email before logging in admin audit.
# Generate with: openssl rand -hex 16
ADMIN_FINGERPRINT_SALT=replace-me-16-bytes-hex

# Versioned key ring for AES-256-GCM encryption of the TOTP secret.
# Format: ADMIN_TOTP_KEYS=v1:<base64-32-bytes>,v2:<base64-32-bytes>
# Generate a 32-byte key with: openssl rand -base64 32
ADMIN_TOTP_KEYS=v1:replace-me-base64-32-bytes
ADMIN_TOTP_ACTIVE_KEY=v1

# Versioned key ring for GitHub token encryption (same format as above).
GITHUB_TOKEN_ENCRYPTION_KEYS=v1:replace-me-base64-32-bytes
GITHUB_TOKEN_ENCRYPTION_ACTIVE_KEY=v1
