# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/promptstreak?schema=public"

# Integration-test database. The name MUST contain "test" — withTestDb refuses
# to truncate any database whose name does not match /test/i.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5432/promptstreak_test?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="dev-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"
ENABLE_DEV_LOGIN="false"
ALLOW_DEV_LOGIN_NONLOCAL="false"
ENABLE_DEV_TEST_ACCOUNT="false"
DEV_TEST_ACCOUNT_USERNAME="localtest"
DEV_TEST_ACCOUNT_DISPLAY_NAME="Local Test User"
DEV_TEST_ACCOUNT_PROFILE_PUBLIC="true"
DEV_TEST_ACCOUNT_AVATAR_URL=""

# GitHub OAuth (optional for dev — leave blank to use Dev Login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Token encryption (versioned AES-256-GCM)
# JSON object mapping version label → base64-encoded 32-byte key.
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENCRYPTION_KEYS='{"v1":"REPLACE_WITH_BASE64_32B_KEY"}'
GITHUB_TOKEN_ENCRYPTION_ACTIVE_KEY="v1"

# Outbound mail (SMTP). The web app is an SMTP client only; provision the
# server, DKIM/SPF/DMARC, and credentials elsewhere.
# In production, mount the password as a docker secret at
# /run/secrets/smtp_password (or set SMTP_PASSWORD_FILE to override the path).
# In dev, you can fall back to SMTP_PASSWORD instead.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@example.com"
SMTP_PASSWORD=""
SMTP_PASSWORD_FILE=""
MAIL_FROM="Promptstreak <noreply@example.com>"

# Contact form recipient. Submissions from /contact and /report-abuse are
# forwarded to this address. Required for the contact API to send mail.
CONTACT_EMAIL="support@example.com"
