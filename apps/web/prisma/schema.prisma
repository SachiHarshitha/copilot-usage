generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  githubId      Int        @unique
  username      String     @unique
  displayName   String?
  avatarUrl     String?
  profilePublic Boolean    @default(false)
  status        UserStatus @default(ACTIVE)
  /// Soft-delete tombstone. Set when an admin runs DELETE /api/admin/users/[id].
  /// Username/displayName/avatar are anonymized at the same time so the row
  /// can survive for forensics without leaking PII.
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  devices    Device[]
  usageDaily UsageDaily[]
  uploadLogs UploadLog[]
  userStat   UserStat?
  repoStats  RepoStat[]

  // Agent-agnostic (v2) relations — additive; legacy reads remain on the
  // tables above until the migration window closes.
  agentRuns        AgentRun[]
  modelUsageDaily  ModelUsageDaily[]
  actionUsageDaily ActionUsageDaily[]
  productStats     ProductStat[]
  providerStats    ProviderStat[]
  modelStats       ModelStat[]

  // Phase 1a — privacy/identity foundation. Additive; legacy `githubId` and
  // `profilePublic` columns remain as bridge until Phase 1c bake completes.
  identity               UserIdentity?
  privacySettings        PrivacySettings?
  consentEvents          ConsentEvent[]
  deletionJobs           AccountDeletionJob[]
  dataExportRequests     DataExportRequest[]
  abuseReportsFiled      AbuseReport[]            @relation("AbuseReportsByReporter")
  repoVisibilitySettings RepoVisibilitySettings[]

  @@index([status])
}

/// Lifecycle state of an end user. SUSPENDED accounts cannot upload and are
/// hidden from leaderboards. Soft-deleted users have status=ACTIVE but a
/// non-null deletedAt — combine `status='ACTIVE' AND deletedAt IS NULL` for
/// "active and present" filters.
enum UserStatus {
  ACTIVE
  SUSPENDED
}

model Device {
  id         String    @id @default(cuid())
  userId     String
  name       String?
  tokenId    String    @unique
  secretHash String
  lastSeenAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageDaily {
  id              String   @id @default(cuid())
  userId          String
  deviceId        String
  date            DateTime @db.Date
  totalRequests   Int      @default(0)
  promptTokens    BigInt   @default(0)
  outputTokens    BigInt   @default(0)
  totalTokens     BigInt   @default(0)
  premiumRequests Float    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, date])
  @@index([date, userId])
}

model UploadLog {
  id           String    @id @default(cuid())
  userId       String
  deviceId     String
  uploadedAt   DateTime  @default(now())
  ipHash       String
  payloadBytes Int
  bucketCount  Int
  earliestDate DateTime?
  latestDate   DateTime?
  accepted     Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStat {
  userId             String   @id
  totalRequests      Int      @default(0)
  promptTokens       BigInt   @default(0)
  outputTokens       BigInt   @default(0)
  totalTokens        BigInt   @default(0)
  weeklyTokens       BigInt   @default(0)
  rolling30DayTokens BigInt   @default(0)
  premiumRequests    Float    @default(0)
  currentStreakDays  Int      @default(0)
  bestStreakDays     Int      @default(0)
  workspaceCount     Int      @default(0)
  sessionCount       Int      @default(0)
  topModel           String?
  lastSyncedAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalTokens(sort: Desc)])
  @@index([premiumRequests(sort: Desc)])
}

model RepoStat {
  id           String   @id @default(cuid())
  userId       String
  repoIdentity String
  displayMode  String
  githubRepo   String?
  aliasLabel   String?
  isPublic     Boolean  @default(false)
  requests     Int      @default(0)
  promptTokens BigInt   @default(0)
  outputTokens BigInt   @default(0)
  totalTokens  BigInt   @default(0)
  tokens30d    BigInt   @default(0)
  premiumReqs  Float    @default(0)
  topModel     String?
  lastSyncedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoIdentity])
  @@index([isPublic, totalTokens(sort: Desc)])
  @@index([githubRepo])
}

// ---------------------------------------------------------------------------
// Agent-agnostic (v2) tables
//
// These are additive. They co-exist with UsageDaily/UserStat/RepoStat during
// the migration window. The upload route writes both legacy and canonical
// rows; existing read paths stay on the legacy tables until UI/API is
// switched over (Task 6, Task 10).
// ---------------------------------------------------------------------------

/// Registered agent adapters and their capability flags. Optional table —
/// adapters not registered here are still accepted on upload but appear
/// without metadata in admin views.
model AgentAdapter {
  id                           String   @id // e.g. "github-copilot-vscode"
  provider                     String
  product                      String
  surface                      String
  displayName                  String?
  supportsTokens               Boolean  @default(false)
  supportsCosts                Boolean  @default(false)
  supportsRunIds               Boolean  @default(false)
  supportsRepoAttribution      Boolean  @default(false)
  supportsToolActions          Boolean  @default(false)
  supportsVerifiedProviderData Boolean  @default(false)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@index([provider, product])
}

/// One normalized agent run (session) as reported by an adapter.
model AgentRun {
  id            String    @id @default(cuid())
  userId        String
  deviceId      String
  adapter       String
  provider      String
  product       String
  surface       String
  runExternalId String
  startedAt     DateTime?
  endedAt       DateTime?
  repoIdentity  String?
  trustLevel    String // "verified" | "observed" | "inferred"
  observedAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, adapter, runExternalId])
  @@index([userId, observedAt])
  @@index([provider, product])
  @@index([repoIdentity])
}

/// Daily aggregated model usage by full agent dimensions.
model ModelUsageDaily {
  id               String   @id @default(cuid())
  userId           String
  deviceId         String
  date             DateTime @db.Date
  provider         String
  product          String
  surface          String
  modelId          String
  repoIdentity     String?
  trustLevel       String   @default("observed")
  requestCount     Int      @default(0)
  inputTokens      BigInt   @default(0)
  outputTokens     BigInt   @default(0)
  totalTokens      BigInt   @default(0)
  cacheReadTokens  BigInt   @default(0)
  cacheWriteTokens BigInt   @default(0)
  costMicros       BigInt   @default(0)
  premiumRequests  Float    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, date, provider, product, surface, modelId, repoIdentity])
  @@index([date, userId])
  @@index([userId, provider, product])
  @@index([userId, modelId])
}

/// Daily aggregated action counts (tool calls, terminal commands, edits, …).
model ActionUsageDaily {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String
  date         DateTime @db.Date
  provider     String
  product      String
  surface      String
  repoIdentity String?
  actionType   String // "tool_call" | "terminal_command" | "file_edit" | …
  count        Int      @default(0)
  filesTouched Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId, date, provider, product, surface, actionType, repoIdentity])
  @@index([date, userId])
  @@index([userId, provider, product])
}

/// Per-user × product rollup. Powers profile breakdowns ("62% Copilot, …").
model ProductStat {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  product         String
  totalRequests   Int      @default(0)
  totalTokens     BigInt   @default(0)
  costMicros      BigInt   @default(0)
  premiumRequests Float    @default(0)
  lastSyncedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, product])
  @@index([provider, product, totalTokens(sort: Desc)])
}

/// Per-user × provider rollup.
model ProviderStat {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  totalRequests   Int      @default(0)
  totalTokens     BigInt   @default(0)
  costMicros      BigInt   @default(0)
  premiumRequests Float    @default(0)
  lastSyncedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([provider, totalTokens(sort: Desc)])
}

/// Per-user × model rollup. Powers "favorite model" surfaces.
model ModelStat {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  product         String
  modelId         String
  totalRequests   Int      @default(0)
  totalTokens     BigInt   @default(0)
  costMicros      BigInt   @default(0)
  premiumRequests Float    @default(0)
  lastSyncedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, product, modelId])
  @@index([modelId, totalTokens(sort: Desc)])
}

// =====================================================================
// Admin console (Phase A.1)
// Backed by separate auth surface — no relation to public User model.
// =====================================================================

enum AdminRole {
  READ_ONLY
  MODERATOR
  ADMIN
}

/// Admin operator. Email is stored lowercased; uniqueness enforced at the DB
/// layer plus app-level normalisation. Passwords hashed with bcrypt (cost >= 12).
model AdminUser {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  role              AdminRole @default(READ_ONLY)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions       AdminSession[]
  totpSecret     AdminTotpSecret?
  recoveryCodes  AdminRecoveryCode[]
  actionLogs     AdminActionLog[]
  badgeOverrides AdminBadgeOverride[]

  @@index([role])
}

/// Active admin session. tokenHash is sha256 of an opaque session token; the
/// raw token lives only in the __Host- cookie. Sessions are double-bounded
/// (idle + absolute) so even an idle attacker cannot extend indefinitely.
/// twoFactorCompletedAt is null on a freshly issued (pre-2FA) session and
/// set once the operator has verified a TOTP/recovery code.
model AdminSession {
  id                   String    @id @default(cuid())
  adminUserId          String
  tokenHash            String    @unique
  twoFactorCompletedAt DateTime?
  idleExpiresAt        DateTime
  absoluteExpiresAt    DateTime
  ipHash               String?
  userAgentHash        String?
  createdAt            DateTime  @default(now())
  revokedAt            DateTime?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([idleExpiresAt])
  @@index([absoluteExpiresAt])
}

/// 1-to-1 TOTP seed for an admin. encryptedSecret is produced by
/// src/lib/crypto/tokenEncryption (AES-256-GCM, versioned key ring).
/// confirmedAt is null until the operator verifies their first code.
model AdminTotpSecret {
  id              String    @id @default(cuid())
  adminUserId     String    @unique
  encryptedSecret String
  confirmedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

/// Single-use recovery codes (10 per admin by default). codeHash is bcrypt of
/// the displayed code. usedAt being non-null marks the code as consumed.
model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  codeHash    String
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

/// Append-only audit log of every admin mutation. The Postgres immutability
/// trigger (BEFORE UPDATE OR DELETE -> RAISE) is added in Phase E so updates
/// remain possible while fixtures stabilise. adminUserId uses SetNull so the
/// log row survives even if the admin account is deleted — adminEmailHash
/// captures the actor's identity at the time of the action.
model AdminActionLog {
  id             String   @id @default(cuid())
  adminUserId    String?
  adminEmailHash String
  action         String
  targetType     String?
  targetId       String?
  ipHash         String?
  userAgentHash  String?
  before         Json?
  after          Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
}

/// Manual override that forces `UserVerification.publicBadgeEligible` to a
/// chosen value regardless of the computed eligibility. Inserted by Phase C.4
/// admin actions; consulted by `resolveBadgeEligibility` (and, once it lands,
/// by Verification Task 4.1's `recomputeBadgeEligibility`). Append-only:
/// each new override row supersedes the previous one rather than mutating it,
/// which keeps a complete history alongside the immutable AdminActionLog.
/// `expiresAt` is null for an indefinite override, otherwise the override is
/// ignored once `now() > expiresAt`. createdById uses SetNull so the row
/// survives even if the admin account is later deleted.
model AdminBadgeOverride {
  id          String    @id @default(cuid())
  userId      String
  eligible    Boolean
  reason      String
  expiresAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([expiresAt])
}

/// One row per outbound mail send attempt. The recipient address is stored
/// hashed only — never plaintext — so the table can be retained for audit
/// without becoming a long-term store of user email addresses.
model MailLog {
  id                String        @id @default(cuid())
  /// sha256 of the lowercased recipient (matches `hashEmail`).
  recipientHash     String
  templateId        String
  /// SMTP / provider message id, when delivery returned one. Null on failure.
  providerMessageId String?
  status            MailLogStatus @default(SENT)
  /// Brief failure reason; never includes the recipient address or template
  /// variables.
  errorReason       String?
  /// Number of attempts made (1 = first try succeeded; 2 = one retry).
  attempts          Int           @default(1)
  createdAt         DateTime      @default(now())

  @@index([recipientHash, createdAt(sort: Desc)])
  @@index([templateId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
}

enum MailLogStatus {
  SENT
  FAILED
}

// ============================================================================
// Verification surface (per docs/promptstreak-verification-concrete-spec.md §8)
// ============================================================================

/// One row per user describing the current state of GitHub-billing
/// verification and the most recently computed mismatch numbers. Updated by
/// the verification refresh job; read by Phase C admin views.
model UserVerification {
  id     String @id @default(cuid())
  userId String @unique

  githubBillingConnected Boolean            @default(false)
  githubBillingStatus    VerificationStatus @default(NOT_CONNECTED)

  verifiedAt    DateTime?
  lastCheckedAt DateTime?
  lastHealthyAt DateTime?

  currentPeriodKey        String?
  localPremiumRequests    BigInt?
  verifiedPremiumRequests BigInt?
  differenceAbsolute      BigInt?
  differencePercent       Decimal? @db.Decimal(8, 4)

  mismatchScore Int @default(0)
  trustScore    Int @default(0)

  publicBadgeEligible Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([githubBillingStatus, lastCheckedAt])
}

enum VerificationStatus {
  NOT_CONNECTED
  CONNECTED
  HEALTHY
  MINOR_MISMATCH
  WARNING
  MISMATCH
  UNSUPPORTED
  EXPIRED
  ERROR
}

/// One row per upload-attempt seen by /api/upload. Records signature outcome
/// and journal chain head so admins can search for replay attempts, signature
/// failures, and chain rewrites without touching the (much hotter) usage
/// tables. Used by Phase D (upload audit search).
model UploadAudit {
  id       String  @id @default(cuid())
  userId   String
  deviceId String?
  tokenId  String?

  receivedAt      DateTime  @default(now())
  clientTimestamp DateTime?
  clientVersion   String?

  payloadHash       String?
  signatureStatus   UploadSignatureStatus
  chainHead         String?
  previousChainHead String?

  accepted      Boolean
  rejectionCode String?

  ipHash        String?
  userAgentHash String?

  @@index([userId, receivedAt])
  @@index([tokenId, receivedAt])
  @@index([signatureStatus, receivedAt])
}

enum UploadSignatureStatus {
  VALID
  MISSING
  INVALID
  STALE_TIMESTAMP
  REPLAYED_NONCE
  BODY_HASH_MISMATCH
  DEVICE_REVOKED
}

/// One row per detected anomaly. Open anomalies (resolvedAt = null) form the
/// queue surfaced to admins in Phase C. `detailsJson` is opaque to the schema;
/// callers must never put raw PII into it (use hashes).
model VerificationAnomaly {
  id     String @id @default(cuid())
  userId String

  code        VerificationAnomalyCode
  severity    VerificationSeverity
  summary     String
  detailsJson Json?

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?
  resolution String?

  @@index([userId, detectedAt])
  @@index([code, detectedAt])
  @@index([resolvedAt, severity])
}

enum VerificationAnomalyCode {
  PREMIUM_MISMATCH_MINOR
  PREMIUM_MISMATCH_WARNING
  PREMIUM_MISMATCH_LARGE
  IMPOSSIBLE_DAILY_SPIKE
  IMPOSSIBLE_THROUGHPUT
  REPLAY_ATTEMPT
  INVALID_SIGNATURE
  JOURNAL_CHAIN_REWRITE
  HISTORIC_REWRITE
  DEVICE_FINGERPRINT_COLLISION
}

enum VerificationSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================================
// Phase 1a — Identity & privacy schema foundation
// (per docs/gdpr/promptstreak-complete-gdpr-mvp-implementation-prompt.md)
//
// All defaults privacy-first. Existing `User.githubId` and `User.profilePublic`
// remain as bridge columns until Phase 1c bake completes.
// ============================================================================

/// Encrypted identity row — one per User. Holds the AES-GCM ciphertext of the
/// GitHub user ID (and optional email) plus a deterministic HMAC used for
/// lookup. The HMAC pepper is held in env, never in DB. See
/// `apps/web/src/lib/crypto/identityCrypto.ts` (Phase 1b).
model UserIdentity {
  id                 String   @id @default(cuid())
  userId             String   @unique
  /// HMAC-SHA256(pepper, normalized GitHub numeric ID). base64url, 43 chars.
  /// Unique + indexed so dual-read auth (Phase 1c) can resolve a session
  /// without ever decrypting a row.
  githubIdHmac       String   @unique
  /// AES-GCM ciphertext of the GitHub numeric ID. Format defined by
  /// identityCrypto.encrypt(): version || iv || ciphertext+tag (base64).
  githubIdCiphertext String
  /// Optional. HMAC-SHA256(pepper, normalized lowercased email).
  emailHmac          String?  @unique
  /// Optional. AES-GCM ciphertext of the email address.
  emailCiphertext    String?
  /// Active key version for both ciphertexts (key rotation lives in
  /// identityCrypto, this column lets the row be re-encrypted lazily).
  keyVersion         Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyVersion])
}

/// Per-user privacy toggles. ALL defaults are FALSE — users must opt-in to
/// every public surface. Mirrors and supersedes the legacy
/// `User.profilePublic` column during the bridge period.
model PrivacySettings {
  userId           String    @id
  profilePublic    Boolean   @default(false)
  leaderboardOptIn Boolean   @default(false)
  badgesEnabled    Boolean   @default(false)
  /// True if the user has accepted the current privacy policy version.
  policyVersion    String?
  policyAcceptedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Append-only consent log (GDPR Art. 7 §1 — controllers must demonstrate
/// consent). Every flip of a privacy toggle, every per-repo opt-in, every
/// account-deletion request, and every admin override writes one row here.
/// Rows are NEVER deleted; soft-delete cascades intentionally do not apply.
model ConsentEvent {
  id        String             @id @default(cuid())
  userId    String
  kind      ConsentEventKind
  granted   Boolean
  source    ConsentEventSource
  /// Optional pointer for kinds that scope to a sub-resource, e.g. the repo
  /// identity for REPO_PUBLIC. Free text — interpreted per `kind`.
  subjectId String?
  /// Pre-hashed IP captured at consent time (pepper from env). Never raw.
  ipHash    String?
  userAgent String?
  createdAt DateTime           @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([kind, createdAt(sort: Desc)])
}

enum ConsentEventKind {
  PROFILE_PUBLIC
  LEADERBOARD_OPT_IN
  BADGES_ENABLED
  REPO_PUBLIC
  WORKSPACE_PUBLIC
  POLICY_ACCEPTED
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETION_CONFIRMED
  ACCOUNT_DELETION_CANCELLED
  DATA_EXPORT_REQUESTED
}

enum ConsentEventSource {
  USER_SETTING
  SIGNUP_DEFAULT
  ADMIN_OVERRIDE
  SYSTEM
}

/// Two-step account deletion (GDPR Art. 17). User requests deletion → email
/// confirm link → grace window → executor anonymizes the User row. One ACTIVE
/// (status in PENDING|CONFIRMED) job per user at a time.
model AccountDeletionJob {
  id               String                   @id @default(cuid())
  userId           String
  status           AccountDeletionJobStatus @default(PENDING)
  /// Optional free-text reason supplied by the user.
  reason           String?
  /// SHA-256 hash of the single-use confirmation token mailed to the user.
  /// Plaintext token is never stored.
  confirmTokenHash String                   @unique
  requestedAt      DateTime                 @default(now())
  confirmedAt      DateTime?
  /// When the executor actually anonymized the user.
  executedAt       DateTime?
  /// When this job is no longer eligible to be confirmed.
  expiresAt        DateTime
  cancelledAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
}

enum AccountDeletionJobStatus {
  PENDING
  CONFIRMED
  EXECUTED
  EXPIRED
  CANCELLED
}

/// DSAR — Data Subject Access Request. User clicks "Download my data",
/// async job builds a JSON archive, user gets a one-time download link.
model DataExportRequest {
  id                String                  @id @default(cuid())
  userId            String
  status            DataExportRequestStatus @default(PENDING)
  requestedAt       DateTime                @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  /// SHA-256 hash of the one-time download token. Never stored plaintext.
  downloadTokenHash String?                 @unique
  downloadExpiresAt DateTime?
  downloadedAt      DateTime?
  /// Compressed archive size, set when completed.
  sizeBytes         Int?
  errorReason       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, requestedAt(sort: Desc)])
  @@index([status, requestedAt])
}

enum DataExportRequestStatus {
  PENDING
  IN_PROGRESS
  READY
  DOWNLOADED
  EXPIRED
  FAILED
}

/// Public-surface abuse / takedown reports (Phase 6.1). Reporter MAY be
/// anonymous (reporterUserId null + reporterEmail set) or signed-in.
model AbuseReport {
  id                String                 @id @default(cuid())
  reporterUserId    String?
  /// Optional contact email for anonymous reporters. Plaintext for now —
  /// Phase 6.1 will decide if this also goes through identityCrypto.
  reporterEmail     String?
  reporterIpHash    String?
  subjectKind       AbuseReportSubjectKind
  /// Username or repo slug being reported.
  subjectIdentifier String
  /// Categorization, e.g. "impersonation", "spam", "doxxing".
  reason            String
  description       String
  status            AbuseReportStatus      @default(NEW)
  resolvedById      String?
  resolutionNotes   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  reporter User? @relation("AbuseReportsByReporter", fields: [reporterUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([subjectKind, subjectIdentifier])
}

enum AbuseReportSubjectKind {
  USER
  REPO
  BADGE
}

enum AbuseReportStatus {
  NEW
  TRIAGED
  ACTIONED
  DISMISSED
}

/// Per-(user, repo) public-visibility opt-in. Decoupled from RepoStat.isPublic
/// so it survives stat resets / re-aggregations and gives us a single source
/// of truth for "did the user explicitly opt this repo into public surfaces?".
/// Phase 2.1 cuts the public read paths over to JOIN here instead of reading
/// RepoStat.isPublic directly.
model RepoVisibilitySettings {
  id           String   @id @default(cuid())
  userId       String
  /// Same value as RepoStat.repoIdentity for the same repo.
  repoIdentity String
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, repoIdentity])
  @@index([isPublic, repoIdentity])
}
